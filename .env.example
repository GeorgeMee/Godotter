GODOT_PATH=
GDCLI_PATH=
GODOTTER_WORKSPACE_ROOT=
GODOTTER_DEFAULT_MODE=plan
GODOTTER_DEFAULT_BRAIN=stub
GODOTTER_DEFAULT_PROJECT=
GODOTTER_PROJECT_REGISTRY_PATH=config/projects.toml
GODOTTER_LOG_LEVEL=INFO
GODOTTER_EXPORT_TEMPLATES_PATH=
GODOTTER_MEMORY_PATH=.godotter/memory.md
GODOTTER_PROJECTS_ROOT=

# AI provider keys and models
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-32B
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen-plus
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6

# Task-specific brain / model overrides (optional, falls back to DEFAULT_BRAIN)
GODOTTER_CHAT_BRAIN=
GODOTTER_CHAT_MODEL=
GODOTTER_PLAN_BRAIN=
GODOTTER_PLAN_MODEL=
GODOTTER_ACT_BRAIN=
GODOTTER_ACT_MODEL=

# Android export (required by Godot headless; godotter uses GODOTTER_* variants first)
ANDROID_HOME=
JAVA_HOME=

# Android export — godotter-specific
GODOTTER_JAVA_HOME=
GODOTTER_ANDROID_SDK_PATH=
GODOTTER_ANDROID_KEYSTORE_PATH=
GODOTTER_ANDROID_KEYSTORE_PASS=
GODOTTER_ANDROID_KEYSTORE_USER=
